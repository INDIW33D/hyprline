[Unit]
Description=Hyprline Status Bar
Documentation=https://github.com/indiw33d/hyprline
PartOf=graphical-session.target
After=graphical-session.target hyprline-notifications.service
Wants=hyprline-notifications.service

[Service]
Type=simple
ExecStart=%h/.local/bin/hyprline-bar
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
