[Unit]
Description=Hyprline Notification Daemon
Documentation=https://github.com/indiw33d/hyprline
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=org.freedesktop.Notifications
ExecStart=%h/.local/bin/hyprline-notifications
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
