+fn parse_workspace_bind_labels(response: &str) -> Result<HashMap<i32, String>, serde_json::Error> {
+    let binds: Vec<HyprlandBind> = serde_json::from_str(response)?;
+    let mut labels = HashMap::new();
+
+    for bind in binds {
+        let Some(workspace_id) = bind.workspace_id() else {
+            continue;
+        };
+
+        let label = bind.key.to_uppercase();
+
+        match labels.entry(workspace_id) {
+            Entry::Vacant(entry) => {
+                entry.insert(label);
+            }
+            Entry::Occupied(mut entry) if is_numeric_label(entry.get()) && !is_numeric_label(&label) => {
+                entry.insert(label);
+            }
+            Entry::Occupied(_) => {}
+        }
+    }
+
+    Ok(labels)
+}
+
+fn is_numeric_label(label: &str) -> bool {
+    !label.is_empty() && label.chars().all(|ch| ch.is_ascii_digit())
+}
+
+#[derive(Debug, Deserialize)]
+struct HyprlandBind {
+    dispatcher: String,
+    arg: String,
+    key: String,
+    #[serde(default)]
+    submap: Option<String>,
+    #[serde(default)]
+    mouse: bool,
+}
+
+impl HyprlandBind {
+    fn workspace_id(&self) -> Option<i32> {
+        if self.dispatcher != "workspace" || self.mouse || !self.submap.as_deref().unwrap_or("").is_empty() {
+            return None;
+        }
+
+        if !self.arg.chars().all(|ch| ch.is_ascii_digit()) {
+            return None;
+        }
+
+        self.arg.parse::<i32>().ok().filter(|id| *id > 0)
+    }
+}
+
